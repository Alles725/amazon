# Copy to .env for running outside Kubernetes. Never commit a real .env.
# In-cluster these values come from ConfigMaps and Secrets instead.

APP_ENV=local
LOG_LEVEL=debug

# API
PORT=3001
DATABASE_URL=postgresql://amazon_mvp:local-dev-password@localhost:5432/amazon_mvp?schema=public
SESSION_COOKIE_NAME=amzmvp_sid
SESSION_TTL_HOURS=168
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
OPENAPI_ENABLED=true

# Storefront
API_INTERNAL_URL=http://localhost:3001
API_PUBLIC_BASE_PATH=/api/v1
FEATURES_FILE=../../../config/features.yaml
