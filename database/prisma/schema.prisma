// Money is ALWAYS stored as integer minor units (e.g. cents) — never Float.
// order_items snapshot product data so historical orders never change when the
// catalog changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions  Session[]
  carts     Cart[]
  orders    Order[]
  addresses    Address[]
  lists        List[]
  paymentCards PaymentCard[]

  @@map("users")
}

model Address {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  recipient            String
  postalCode           String   @map("postal_code")
  street               String
  number               String
  complement           String?
  neighborhood         String
  city                 String
  state                String   @db.Char(2)
  // National number (DDD + número, digits only); shown as +55… on the account page.
  phone                String?
  deliveryInstructions String?  @map("delivery_instructions")
  // At most one default per user; enforced by UsersRepository under a per-user lock.
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// Simulated saved card (CARD-001). Only what a real PSP would hand back after
// tokenization: brand, last four digits, holder and expiry. The full number and
// CVV are never sent to the API, let alone stored.
model PaymentCard {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  brand      String
  last4      String   @db.Char(4)
  holderName String   @map("holder_name")
  expMonth   Int      @map("exp_month") @db.SmallInt
  expYear    Int      @map("exp_year") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_cards")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Only a SHA-256 hash of the opaque token is stored. A database leak must not
  // hand out usable sessions.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  // Taxonomy: a product's breadcrumb is the ancestor chain of its category.
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  slug        String   @unique
  name        String
  description String?
  priceMinor  Int      @map("price_minor")
  currency    String   @default("BRL") @db.Char(3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categories ProductCategory[]
  inventory  Inventory?
  cartItems  CartItem[]

  @@index([active])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FULFILLED

  @@map("order_status")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  orderNumber String      @unique @map("order_number")
  status      OrderStatus @default(PENDING)
  totalMinor  Int         @map("total_minor")
  currency    String      @default("BRL") @db.Char(3)
  placedAt    DateTime    @default(now()) @map("placed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sourceCartId    String? @unique @map("source_cart_id") @db.Uuid
  subtotalMinor   Int     @default(0) @map("subtotal_minor")
  shippingMinor   Int     @default(0) @map("shipping_minor")
  discountMinor   Int     @default(0) @map("discount_minor")
  shippingAddress Json?   @map("shipping_address")
  paymentMethod   String? @map("payment_method")
  // SIMULATED_CARD only: { brand, last4 } snapshot and interest-free installment count.
  paymentCard     Json?   @map("payment_card")
  installments    Int?

  // Delivery tracking. Null until the carrier confirms delivery.
  deliveredAt  DateTime? @map("delivered_at")
  deliveryNote String?   @map("delivery_note")

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, placedAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  // Snapshot fields: intentionally NOT a relation to products. The product may
  // be renamed, repriced or deleted; the order must not change.
  productId      String @map("product_id") @db.Uuid
  productName    String @map("product_name")
  sku            String
  quantity       Int
  unitPriceMinor Int    @map("unit_price_minor")
  lineTotalMinor Int    @map("line_total_minor")
  currency       String @default("BRL") @db.Char(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Reviews module (REVIEWS_API). Products and users are referenced by id only,
// with no foreign key into catalog/users tables (same boundary as order_items):
// the module checks product existence through CATALOG_API when a review is
// written, and could move to its own service without touching other tables.
// ---------------------------------------------------------------------------

enum ReviewSource {
  CUSTOMER
  // Fixture texts from config/demo-reviews.json, written by `seed:demo`.
  DEMO

  @@map("review_source")
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  // Null only for DEMO fixtures, which have no account behind them.
  userId           String?      @map("user_id") @db.Uuid
  // Public name snapshot ("Camila S."), refreshed when the author edits.
  authorName       String       @map("author_name")
  rating           Int          @db.SmallInt
  title            String
  body             String
  // Set through ORDERS_API when the review is written or edited.
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  // Denormalised count of review_helpful_votes (plus the fixture count for DEMO rows).
  helpfulCount     Int          @default(0) @map("helpful_count")
  source           ReviewSource @default(CUSTOMER)
  // Stable fixture id that keeps `seed:demo` idempotent. Null for customer reviews.
  fixtureKey       String?      @unique @map("fixture_key")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  helpfulVotes ReviewHelpfulVote[]

  // One review per customer per product (NULL user ids never collide).
  @@unique([productId, userId])
  @@index([productId, helpfulCount])
  @@index([productId, createdAt])
  @@index([productId, rating])
  @@map("reviews")
}

model ReviewHelpfulVote {
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
  @@map("review_helpful_votes")
}

// Aggregate ratings imported from the demo listings (config/demo-products.json)
// by `seed:demo`. No written texts exist behind them; summaries add the real
// reviews on top. Variant records of one demo listing carry the same aggregate
// (same listing_key), counted once when a whole variant family is summarised.
model ReviewRatingBaseline {
  productId    String   @id @map("product_id") @db.Uuid
  listingKey   String   @map("listing_key")
  ratingCount  Int      @map("rating_count")
  // Sum of the stars, so averages merge exactly with real reviews.
  ratingSum    Int      @map("rating_sum")
  // Percent per star level, 5 stars first; empty when the listing gave none.
  distribution Int[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([listingKey])
  @@map("review_rating_baselines")
}

// Lists module ("Suas listas"). Items reference catalog products by id only —
// no foreign key into the catalog's tables; product data is read through
// CATALOG_API, and items whose product no longer exists are simply not shown.
model List {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  // The lazily created "Lista de desejos". Exactly one per user once created.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]

  @@index([userId])
  @@map("lists")
}

model ListItem {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, productId])
  @@map("list_items")
}
