  "info": {
    "title": "Amazon MVP API",
    "description": "Modular monolith API for the MVP skeleton. Sessions are opaque cookies.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "protected",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "amzmvp_sid"
      }
    },
    "schemas": {
      "IdentifyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "IdentifyResponseDto": {
        "type": "object",
        "properties": {
          "exists": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "exists"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "example": "correct horse battery staple",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "createdAt"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "expiresAt"
        ]
      },
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUTH_INVALID_CREDENTIALS"
          },
          "message": {
            "type": "string",
            "example": "Invalid credentials"
          },
          "requestId": {
            "type": "string",
            "example": "3f1a..."
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct horse battery staple"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "CatalogItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "priceMinor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          },
          "active": {
            "type": "boolean"
          },
          "availableQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "inStock": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "sku",
          "slug",
          "name",
          "description",
          "priceMinor",
          "currency",
          "active",
          "availableQuantity",
          "inStock"
        ]
      },
      "CatalogPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItemDto"
            }
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "CartItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "product": {
            "$ref": "#/components/schemas/CatalogItemDto"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPriceMinor": {
            "type": "integer"
          },
          "lineTotalMinor": {
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "product",
          "quantity",
          "unitPriceMinor",
          "lineTotalMinor"
        ]
      },
      "CartResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemDto"
            }
          },
          "itemCount": {
            "type": "integer"
          },
          "subtotalMinor": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          }
        },
        "required": [
          "id",
          "userId",
          "lines",
          "itemCount",
          "subtotalMinor",
          "currency"
        ]
      },
      "AddCartItemDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "quantity",
          "productId"
        ]
      },
      "CartQuantityDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "quantity"
        ]
      }
    }
  }
}
